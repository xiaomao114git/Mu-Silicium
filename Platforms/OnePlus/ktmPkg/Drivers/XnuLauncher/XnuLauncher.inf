## @file
#  XnuLauncher - DXE driver that hands off to the HakiOS xnuloader at ReadyToBoot.
#
#  The handoff is deferred to ReadyToBoot because Mu-Silicium's BDS clears the
#  console after DXE, hiding anything printed during the entry point.
##

[Defines]
  INF_VERSION                    = 0x0010005
  BASE_NAME                      = XnuLauncher
  FILE_GUID                      = 6B2D94F7-1C58-4A30-B7E1-9D3E5A8C4602
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = XnuLauncherEntry

[Sources]
  XnuLauncher.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  DebugLib
  PrintLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib
  MemoryAllocationLib

[Guids]
  gEfiEventReadyToBootGuid

[Protocols]
  gEfiFirmwareVolume2ProtocolGuid

[Depex]
  TRUE
